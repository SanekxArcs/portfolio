# Google AI (Gemini) API Key
# Get your API key from https://makersuite.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Sanity Configuration (if not already set)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-12-15

# Optional read-only token for private datasets / Sanity Live.
# In this implementation it can be sent to the browser by SanityLive.
# Never use a write or admin token here.
# SANITY_API_READ_TOKEN=your_sanity_read_token_here

# Sanity API Token with write permissions (required for chat history)
# Get this from your Sanity project settings > API > Tokens
# Make sure the token has Editor or Admin permissions
SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# Public site URL used in the AI assistant context
# NEXT_PUBLIC_SITE_URL=https://example.com

# Google Analytics (if not already set)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=your_ga_id
